{
  "expo": {
    "name": "Iron",
    "slug": "iron",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "iron",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "dev.rakesh.iron",
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE",
        "VIBRATE",
        "WAKE_LOCK"
      ],
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0D"
      }
    },
    "ios": {
      "bundleIdentifier": "dev.rakesh.iron",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E8552E"
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0D",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#0B0B0D",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8a3d4212-67e5-46a9-936d-ecfd7b19f081"
      }
    },
    "owner": "crazybutton",
    "icon": "./assets/icon.png"
  }
}
