{
  "expo": {
    "name": "Iron",
    "slug": "iron",
    "version": "0.5.0",
    "orientation": "portrait",
    "scheme": "iron",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "dev.rakesh.iron",
      "allowBackup": false,
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE",
        "VIBRATE",
        "WAKE_LOCK"
      ],
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0D"
      }
    },
    "ios": {
      "bundleIdentifier": "dev.rakesh.iron",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E8552E"
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0D",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "IBM Plex Sans",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/IBMPlexSans_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/IBMPlexSans_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/IBMPlexSans_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/IBMPlexSans_700Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Archivo",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Archivo_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Archivo_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Archivo_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Archivo_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Archivo_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/IBMPlexSans_400Regular.ttf",
              "./assets/fonts/IBMPlexSans_500Medium.ttf",
              "./assets/fonts/IBMPlexSans_600SemiBold.ttf",
              "./assets/fonts/IBMPlexSans_700Bold.ttf",
              "./assets/fonts/Archivo_400Regular.ttf",
              "./assets/fonts/Archivo_500Medium.ttf",
              "./assets/fonts/Archivo_600SemiBold.ttf",
              "./assets/fonts/Archivo_700Bold.ttf",
              "./assets/fonts/Archivo_800ExtraBold.ttf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#0B0B0D",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8a3d4212-67e5-46a9-936d-ecfd7b19f081"
      }
    },
    "owner": "crazybutton",
    "icon": "./assets/icon.png"
  }
}
